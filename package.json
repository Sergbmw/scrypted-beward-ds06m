{
   "name": "scrypted-beward-ds06m",
   "version": "0.4.0",
   "description": "Плагин Scrypted для домофона BEWARD DS06M: HomeKit, SIP-аудио и управление калиткой.",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Sergbmw/scrypted-beward-ds06m.git"
   },
   "bugs": {
      "url": "https://github.com/Sergbmw/scrypted-beward-ds06m/issues"
   },
   "homepage": "https://github.com/Sergbmw/scrypted-beward-ds06m#readme",
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "prepublishOnly": "cross-env NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-readme": "scrypted-readme",
      "scrypted-package-json": "scrypted-package-json"
   },
   "keywords": [
      "scrypted",
      "plugin",
      "sip",
      "homekit",
      "beward",
      "ds06m",
      "doorbell"
   ],
   "scrypted": {
      "name": "BEWARD DS06M",
      "type": "DeviceProvider",
      "interfaces": [
         "ScryptedSystemDevice",
         "ScryptedDeviceCreator",
         "DeviceProvider",
         "DeviceCreator",
         "MixinProvider"
      ],
      "pluginDependencies": [
         "@scrypted/prebuffer-mixin",
         "@scrypted/snapshot"
      ]
   },
   "dependencies": {
      "@slyoldfox/sip": "^0.0.6-1",
      "pick-port": "^1.0.0",
      "rxjs": "^7.8.1",
      "sdp": "^3.0.3"
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.5.59",
      "@types/node": "^20.11.30",
      "cross-env": "^7.0.3",
      "terser-webpack-plugin": "^5.3.14"
   }
}
